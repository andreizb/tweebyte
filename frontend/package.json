{
  "name": "tweebyte-frontend",
  "version": "0.1.0",
  "description": "Tweebyte — X-grade Angular 17 frontend talking to one backend-agnostic gateway.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mock": "ng serve --configuration mock",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:coverage": "E2E_COVERAGE=1 playwright test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.7",
    "@angular/cdk": "^22.0.5",
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^20.3.25",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/platform-browser-dynamic": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@ngrx/signals": "^21.1.1",
    "jwt-decode": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.6.0",
    "@angular-devkit/build-angular": "^21.2.19",
    "@angular-eslint/builder": "17.5.3",
    "@angular-eslint/eslint-plugin": "17.5.3",
    "@angular-eslint/eslint-plugin-template": "17.5.3",
    "@angular-eslint/schematics": "22.1.0",
    "@angular-eslint/template-parser": "17.5.3",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^17.3.0",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/angular": "^15.2.0",
    "@testing-library/dom": "^10.4.0",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "eslint": "8.57.1",
    "jsdom": "^24.0.0",
    "monocart-coverage-reports": "^2.12.12",
    "msw": "^2.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.4.2",
    "vitest": "^4.1.10"
  }
}
