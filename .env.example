# Tweebyte compose environment variable reference (W14).
# Copy to .env and fill in values for your environment.
# Never commit a real .env — this file documents defaults only.

# ---- W14: Image / registry parameterization --------------------------------

# Prefix for all application service image names.
# Default: tweebyte  → images are named  tweebyte-<svc>-<stack>:<TAG>
IMAGE_PREFIX=tweebyte

# Image tag. Set to a pipeline-built digest or semver tag to pull
# specific builds instead of the locally built :local images.
# Default: local
TAG=local

# Optional registry prefix. When set, images are pulled from
# <REGISTRY>/<IMAGE_PREFIX>-<svc>-<stack>:<TAG>.
# Leave empty to use the local Docker daemon.
# Example: REGISTRY=docker.io/myorg
REGISTRY=

# ---- Stack selector (used by the deploy overlay) ---------------------------
# Set to "async" or "reactive" when using deployment/docker-compose/deploy.yml.
# Default: async
STACK=async

# ---- W1: Vault (secrets) ---------------------------------------------------
# Dev-mode Vault root token. All 8 modules fetch their secrets from Vault at boot
# and fail fast if it is unreachable, so this must be set (compose reads it from
# .env; host-run benchmark/FE export it in the shell) before any service starts.
# Dev-only value — a real deployment issues a scoped, renewable token instead.
VAULT_TOKEN=root

# Secret material seeded into Vault KV (secret/tweebyte) by vault-init.sh. These
# are the values that used to sit in application.properties; they now live only
# here (gitignored .env) and in Vault — never in the committed config.
TWEEBYTE_DB_PASSWORD=postgres
TWEEBYTE_ACTUATOR_PASSWORD=changeme-actuator
TWEEBYTE_LLM_API_KEY=live-llm

# ---- W3: TLS (keystore + truststore passwords) -----------------------------
# Open the PKCS12 keystores + shared truststore that gen-certs.sh mints into
# deployment/docker-compose/tls/. vault-init.sh seeds these into Vault as the
# spring.ssl.bundle.jks.tweebyte.{keystore,truststore}.password keys so every
# service unlocks its SSL bundle at boot. gen-certs.sh defaults to these exact
# values, so a fresh clone that runs gen-certs.sh then brings up a TLS stack
# "just works". To rotate: change both, re-run gen-certs.sh with FORCE=1, re-seed.
TWEEBYTE_TLS_KEYSTORE_PASSWORD=changeit
TWEEBYTE_TLS_TRUSTSTORE_PASSWORD=changeit

# ---- W2: Keycloak (identity provider) --------------------------------------
# The tweebyte-app confidential client's secret. It is consumed in two places
# from this single value: (1) env-substituted into realm-export.json at Keycloak
# import time, and (2) seeded into Vault (app.keycloak.client-secret) so the
# user-service can drive the ROPC + client_credentials grants. Keeping it here
# (gitignored .env) and in Vault — never in the committed realm JSON — mirrors
# the W1/W3 secret handling. Rotate by changing this and re-importing the realm.
TWEEBYTE_KC_CLIENT_SECRET=tweebyte-app-secret

# Keycloak's own bootstrap admin (master realm) + backing-DB credentials. These
# are infra-bootstrap only (like POSTGRES_PASSWORD / the sonar DB creds) — the
# application never reads them, so they stay as compose env with dev defaults
# rather than Vault secrets. Admin console: http://localhost:8090 (admin/admin).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak
