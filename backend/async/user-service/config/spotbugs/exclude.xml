<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
		xmlns="https://github.com/spotbugs/filter/3.0.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

	<!--
		EI_EXPOSE_REP / EI_EXPOSE_REP2 fire on Lombok-generated getters, setters
		and builders that share references to mutable fields (collections, arrays,
		dates) on entities and DTOs. On JPA @Entity classes defensive copies are
		not merely boilerplate but incorrect: Hibernate must own the persistent
		collection instance, so copying a getter/setter breaks dirty-checking and
		orphan removal. This is a known false-positive pattern for Lombok + JPA,
		not a real defect, so it is filtered rather than "fixed".
	-->
	<Match>
		<Bug pattern="EI_EXPOSE_REP"/>
	</Match>
	<Match>
		<Bug pattern="EI_EXPOSE_REP2"/>
	</Match>

</FindBugsFilter>
