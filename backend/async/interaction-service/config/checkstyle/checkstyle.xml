<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
	Spring-team checks. SpringChecks is the published bundle from
	io.spring.javaformat:spring-javaformat-checkstyle (the same module the Spring
	Framework / Spring Boot codebases use). Project-specific extras from
	spring-boot's own checkstyle.xml (import-control, AssertJ/BDDMockito regexps)
	are intentionally omitted — they reference per-project files we don't ship.
-->
<module name="com.puppycrawl.tools.checkstyle.Checker">
	<module name="SuppressionFilter">
		<property name="file" value="${config_loc}/checkstyle-suppressions.xml"/>
		<property name="optional" value="true"/>
	</module>
	<module name="io.spring.javaformat.checkstyle.SpringChecks">
		<!-- Custom MIT SPDX copyright header. Same header.txt that Spotless
		     licenseHeader stamps, so both tools agree. -->
		<property name="headerFile" value="${config_loc}/header.txt"/>
		<!-- Our root package, so SpringImportOrder groups ro.tweebyte.* last (its
		     own group) instead of the org.springframework default. Spotless's
		     importOrder is configured to emit the matching groups. -->
		<property name="projectRootPackage" value="ro.tweebyte"/>
	</module>
</module>
